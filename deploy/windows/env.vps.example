# Euphoria API — ambiente na VPS (NÃO commitar com segredos)
# Copie para C:\euphoria\backend\.env na VPS

AUTH_PROVIDER=self

# Discord OAuth (produção: callback HTTPS do domínio da API)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=https://api.SEU_DOMINIO.com/api/auth/discord/callback

JWT_SECRET=
JWT_ISSUER=euphoria-api
JWT_AUDIENCE=euphoria-app
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=2592000

# Front (Vercel ou outro)
FRONTEND_ORIGIN=https://SEU_FRONT.vercel.app
CORS_ORIGINS=https://SEU_FRONT.vercel.app,http://127.0.0.1:5173
COOKIE_SECURE=true

# SQL Server na mesma VPS (preferir localhost — não expor 1433 na internet)
SQLSERVER_HOST=127.0.0.1
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=euphoria
SQLSERVER_USER=your_sql_user
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes

# Opcional bot
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=
