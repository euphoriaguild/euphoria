# Backend Python — FastAPI (Euphoria)
# Copie para .env e preencha (NÃO commitar .env)

# ── Auth própria (Discord OAuth + JWT) ────────────────────────────────────────
AUTH_PROVIDER=self
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_REDIRECT_URI=http://127.0.0.1:8000/api/auth/discord/callback
JWT_SECRET=
JWT_ISSUER=euphoria-api
JWT_AUDIENCE=euphoria-app
ACCESS_TOKEN_TTL_SEC=3600
REFRESH_TOKEN_TTL_SEC=2592000
FRONTEND_ORIGIN=http://127.0.0.1:5173
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
COOKIE_SECURE=false

# ── Discord bot (opcional — gate de cadastro) ─────────────────────────────────
# DISCORD_BOT_TOKEN=
# DISCORD_GUILD_ID=

# ── Links da guild (onboarding) ───────────────────────────────────────────────
GUILD_DISCORD_URL=https://discord.gg/euphoria-placeholder
GUILD_WHATSAPP_URL=https://chat.whatsapp.com/euphoria-placeholder

# ── SQL Server (VPS) ──────────────────────────────────────────────────────────
SQLSERVER_HOST=YOUR_SQLSERVER_HOST
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=euphoria
SQLSERVER_USER=your_sql_user
SQLSERVER_PASSWORD=
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
# SQLSERVER_CONNECTION_STRING=

# ── Dev only ──────────────────────────────────────────────────────────────────
# AUTH_DEV_MODE=false
