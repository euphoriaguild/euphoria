# Token do bot (Discord Developer Portal → Bot → Reset Token)
DISCORD_BOT_TOKEN=SEU_TOKEN_AQUI

# Supabase (mesmos valores do backend)
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=SEU_SERVICE_ROLE_KEY_AQUI

# IDs do servidor Discord (clique direito no item com Modo Desenvolvedor ativado)
VERIFICATION_CHANNEL_ID=ID_DO_CANAL_VERIFICACAO   # canal público onde aparece "fulano entrou"
PENDING_ROLE_ID=ID_DO_CARGO_PENDENTE               # cargo que o membro ganha após verificar
MEMBER_ROLE_ID=ID_DO_CARGO_MEMBRO                  # cargo que a staff atribui ao aprovar
VERIFIED_CATEGORY_ID=ID_DA_CATEGORIA               # categoria onde os canais temporários são criados
